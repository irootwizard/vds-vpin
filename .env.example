# Copy to .env and adjust paths (optional — scripts auto-detect repo root).
# Do NOT commit .env with secrets.

# --- Repository roots ---
VPIN_REPO_ROOT=D:\path\to\vPIN-main
VPIN_CLIENT_ROOT=D:\path\to\vPIN-main\vpin-client
VPIN_BACKEND_ROOT=D:\path\to\vPIN-main\vpin-backend
# Legacy alias for ahe-cli search path (same as VPIN_CLIENT_ROOT in this repo):
# VPIN_PLATFORM_ROOT=D:\path\to\vPIN-main\vpin-client

# --- Python backend (:8000) ---
VPIN_API_HOST=127.0.0.1
VPIN_API_PORT=8000
VPIN_DATA_DIR=vpin-backend/data
VPIN_BSGS_TABLE=src/Pre_computed_table/table.pickle

# --- Rust AHE client / server ---
# Python route uses table.pickle; Rust route uses table.bin (~208MB, not in Git — see docs/环境配置与手动步骤.md)
# VPIN_BSGS_TABLE=vpin-client/tests/fixtures/table.bin
AHE_SERVER_HOST=127.0.0.1
AHE_SERVER_PORT=8001
VPIN_WEIGHTS_DIR=model_training/outputs/20260622_184254

# --- Python AHE parallelism (CLI; Tauri forces VPIN_AHE_PARALLEL=0) ---
VPIN_AHE_PARALLEL=1
VPIN_AHE_ENCRYPT_WORKERS=8
VPIN_AHE_DECRYPT_WORKERS=3
VPIN_AHE_SERVER_POOL=1
VPIN_AHE_SERVER_WORKERS=3

# --- CP-SNARK / proof (optional) ---
VPIN_CP_SNARK_NETWORK_DEFAULT=A
# VPIN_RUN_DIR=model_training/outputs/20260622_184254
# VPIN_EC_WITNESS_ROOT=model_training/outputs/20260622_184254/proof_artifacts/ec_witness
# VPIN_ALLOW_LEGACY_WITNESS=1
# VPIN_EC_REAL_PROVE=1
